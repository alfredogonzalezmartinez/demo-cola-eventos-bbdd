<?xml version="1.0" encoding="UTF-8"?>
<!-- Suite de integración contra bbdd-test: los tests corren dentro del
     contenedor app1 (PHP no está en el host), así que el DSN es el del
     servicio de compose por DNS interno (el 3307 solo existe en el host) -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="integration">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="EVENTOS_DSN" value="mysql://demo:demo@bbdd-test:3306/eventos" force="true"/>
        <env name="COMERCIO_DSN" value="mysql://demo:demo@bbdd-test:3306/comercio" force="true"/>
    </php>
</phpunit>
