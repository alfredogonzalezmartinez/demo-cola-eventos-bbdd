{
    "name": "demo-cola-eventos-bbdd/app1",
    "description": "Back-office (app1) en Symfony: replica PHP del modelo de eventos de app2 (docs/03-08)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^4.0",
        "symfony/console": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/uid": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
