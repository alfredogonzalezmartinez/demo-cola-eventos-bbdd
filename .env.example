# Credenciales de la demo (ver docs/07-infraestructura.md)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=demo
MYSQL_PASSWORD=demo

# Puerto del host para conectarte por consola/IDE desde fuera de compose
MYSQL_HOST_PORT=3306

# Intervalo del consumo por cron — recordar: granularidad mínima de cron del host = 1 min
CONSUME_INTERVAL_SECONDS=60

# Secreto para la API route de consume de app2
CRON_SECRET=change-me

# Conexiones MySQL por schema: una conexión por BD
MYSQL_EVENTOS_URL=mysql://demo:demo@bbdd:3306/eventos
MYSQL_COMERCIO_URL=mysql://demo:demo@bbdd:3306/comercio
