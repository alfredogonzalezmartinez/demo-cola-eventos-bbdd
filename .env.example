# Credenciales de la demo (ver docs/07-infraestructura.md)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=demo
MYSQL_PASSWORD=demo

# Puerto del host para conectarte por consola/IDE desde fuera de compose
MYSQL_HOST_PORT=3306

# Intervalo del consumo por cron (Fase 3+) — recordar: granularidad mínima de cron del host = 1 min
CONSUME_INTERVAL_SECONDS=60

# Secreto para la API route de consume de app2 (Fase 3+)
CRON_SECRET=change-me
