# Entorno para los tests de integración (make test / npm run test en app2)
# El contenedor de MySQL de tests vive en compose como bbdd-test (profile "test"), publicado en el host 3307.
# Cargado por tests/setup-env.ts (primera importación del test), con prioridad sobre variables heredadas.
MYSQL_EVENTOS_URL=mysql://demo:demo@localhost:3307/eventos
MYSQL_COMERCIO_URL=mysql://demo:demo@localhost:3307/comercio
