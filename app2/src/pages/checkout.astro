---
import "../styles/global.css";

import { container } from "../contexts/shared/infrastructure/dependency-injection/diod.config";
import { MysqlProductRepository } from "../contexts/commerce/products/infrastructure/MysqlProductRepository";

const products = await container.get(MysqlProductRepository).searchAll();
const eur = (amount: number) => `€ ${amount.toFixed(2)}`;
---

<html lang="es" class="bg-slate-950">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Checkout</title>
	</head>
	<body class="bg-slate-950 text-slate-200 font-sans p-6 min-h-screen">
		<main class="max-w-2xl mx-auto">
			<p class="text-sm mb-4">
				<a href="/" class="text-sky-400 hover:text-sky-300">← Tienda</a>
			</p>

			<h1 class="text-2xl font-semibold text-white mb-6">Checkout</h1>

			<form
				method="post"
				action="/api/checkout"
				class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 space-y-5"
			>
				<p class="flex items-center gap-3">
					<label for="email" class="text-sm text-slate-400">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						value="alfredo@demo.dev"
						placeholder="tu@email.com"
						class="flex-1 bg-slate-950 border border-slate-700 focus:border-sky-500 focus:outline-none rounded-lg px-3 py-2 text-sm text-white placeholder:text-slate-600"
					/>
				</p>

				<div class="rounded-lg border border-slate-800 overflow-hidden">
					<table class="w-full text-left text-sm">
						<thead class="text-xs uppercase text-slate-500 bg-slate-900">
							<tr>
								<th class="px-4 py-2">Producto</th>
								<th class="px-4 py-2 text-right">Precio</th>
								<th class="px-4 py-2 text-right">Cantidad</th>
							</tr>
						</thead>
						<tbody>
							{
								products.map((product) => (
									<tr class="border-t border-slate-800/60 hover:bg-slate-900/60 transition-colors">
										<td class="px-4 py-2.5">{product.name}</td>
										<td class="px-4 py-2.5 text-right text-slate-400">{eur(product.priceAmount)}</td>
										<td class="px-4 py-2.5 text-right">
											<input
												type="number"
												name={`product_${product.id}`}
												value="0"
												min="0"
												max="9"
												class="w-16 bg-slate-950 border border-slate-700 focus:border-sky-500 focus:outline-none rounded px-2 py-1 text-right text-sm text-white"
											/>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<button
					type="submit"
					class="w-full bg-sky-600 hover:bg-sky-500 text-white font-medium py-2.5 rounded-lg transition-colors"
				>
					Finalizar compra
				</button>
			</form>
		</main>
	</body>
</html>
