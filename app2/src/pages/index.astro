---
import "../styles/global.css";

import { container } from "../contexts/shared/infrastructure/dependency-injection/diod.config";
import { MysqlProductRepository } from "../contexts/commerce/products/infrastructure/MysqlProductRepository";

const products = await container.get(MysqlProductRepository).searchAll();
const eur = (amount: number) => `€ ${amount.toFixed(2)}`;
---

<html lang="es" class="bg-slate-950">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Tienda</title>
	</head>
	<body class="bg-slate-950 text-slate-200 font-sans p-6 min-h-screen">
		<main class="max-w-2xl mx-auto">
			<div class="flex items-baseline justify-between mb-6">
				<h1 class="text-2xl font-semibold text-white">Tienda</h1>
				<nav class="text-sm space-x-4">
					<a href="/checkout" class="text-sky-400 hover:text-sky-300">Checkout</a>
					<a href="/orders" class="text-sky-400 hover:text-sky-300">Pedidos</a>
				</nav>
			</div>

			<table class="w-full text-left text-sm">
				<thead class="text-xs uppercase text-slate-500 border-b border-slate-800">
					<tr>
						<th class="py-2">Producto</th>
						<th class="py-2 text-right">Precio</th>
						<th class="py-2 text-right">Vistas</th>
					</tr>
				</thead>
				<tbody>
					{
						products.map((product) => (
							<tr class="border-b border-slate-800/60 hover:bg-slate-900/60 transition-colors">
								<td class="py-2.5">
									<a href={`/products/${product.id}`} class="text-sky-400 hover:text-sky-300 hover:underline">
										{product.name}
									</a>
								</td>
								<td class="py-2.5 text-right text-slate-300">{eur(product.priceAmount)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</main>
	</body>
</html>
